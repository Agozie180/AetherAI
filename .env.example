# AetherAI — never commit real keys.
# Default mode is PAPER. LIVE requires explicit AETHER_MODE=live AND real keys.

AETHER_MODE=paper
AETHER_PORT=3100
AETHER_ADMIN_TOKEN=
# Optional durable storage directory. Vercel defaults to ephemeral /tmp/aetherai.
# Use a managed database/storage adapter for durable multi-instance state.
AETHER_DATA_DIR=

# Bitget UTA v3. Demo keys + BITGET_PAPER=1 routes to Bitget Demo (paptrading:1).
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_PAPER=1

# Choose exactly one server-side LLM provider for Council elders and desk answers.
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: SEC EDGAR requires a descriptive User-Agent (email recommended).
RESEARCH_USER_AGENT=AetherAI/0.1 (Bitget Hackathon S2; research@localhost)

# Optional extra news. Leave empty to use Google News RSS + SEC only.
FINNHUB_API_KEY=
NEWSAPI_KEY=

# Risk policy (also in src/lib/policy.ts — env overrides file defaults)
AETHER_MAX_LEVERAGE=5
AETHER_COUNCIL_QUORUM=4
AETHER_PAPER_EQUITY=10000
AETHER_LOOP_MS=300000
AETHER_WATCHLIST=NVDAUSDT,AAPLUSDT,TSLAUSDT,MSFTUSDT,SPYUSDT
